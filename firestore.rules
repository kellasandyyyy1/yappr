rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helpers ---
    function isSignedIn() {
      return request.auth != null;
    }
    function isVerified() {
      // In development, we allow non-verified users for basic operations, 
      // but we still want to encourage verification later.
      return isSignedIn(); 
    }
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }
    function isChatParticipant(cid) {
      // Check if user is in the participants array of the chat document
      let chat = get(/databases/$(database)/documents/chats/$(cid));
      return isSignedIn() && chat != null && request.auth.uid in chat.data.participants;
    }
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }
    function incoming() {
      return request.resource.data;
    }
    function existing() {
      return resource.data;
    }

    // --- Users ---
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isOwner(userId)
        && isVerified()
        && incoming().uid == userId
        && incoming().username is string
        && incoming().createdAt == request.time
        // Same server-stamp requirement as on update.
        && (!incoming().keys().hasAny(['termsAcceptedAt'])
            || incoming().termsAcceptedAt == request.time);
      allow update: if isOwner(userId)
        && isVerified()
        && incoming().get('uid', userId) == userId
        && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'photoURL', 'bio', 'status', 'lastActive', 'themeSong', 'termsVersion', 'termsAcceptedAt'])
        // Consent must be stamped by the server, never by the client clock,
        // so an acceptance record cannot be back-dated from a tampered device.
        && (!incoming().diff(existing()).affectedKeys().hasAny(['termsAcceptedAt'])
            || incoming().termsAcceptedAt == request.time);

      // --- Security event log ---
      // Append-only, and readable only by the account owner. Sign-ins,
      // password changes and 2FA changes land here so a user can audit
      // account activity.
      //
      // No update and no delete: an attacker who compromises a session must
      // not be able to erase the record of their own sign-in. Retention is
      // handled out-of-band (a scheduled job or a TTL policy), not by
      // granting clients delete.
      match /securityEvents/{eventId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId)
          && incoming().userId == userId
          && incoming().type is string
          && incoming().deviceId is string
          && incoming().createdAt == request.time;
        allow update, delete: if false;
      }
    }

    // --- Follows ---
    match /follows/{followId} {
      allow read: if isSignedIn();
      allow create: if isVerified() 
        && incoming().followerId == request.auth.uid
        && incoming().createdAt == request.time;
      allow delete: if isSignedIn() && isOwner(existing().followerId);
    }

    // --- Posts ---
    match /posts/{postId} {
      function isValidPost(data) {
        let requiredKeys = ['userId', 'content', 'createdAt', 'likesCount', 'commentsCount'];
        let optionalKeys = ['imageUrl', 'imageUrls', 'voiceUrl', 'type', 'reactions', 'recentLikers', 'editHistory', 'song', 'visibility'];
        return data.userId is string
          && data.content is string
          && data.likesCount is number
          && data.commentsCount is number
          && data.keys().hasAll(requiredKeys)
          && data.keys().size() <= requiredKeys.size() + optionalKeys.size();
      }

      allow read: if isSignedIn();
      allow create: if isVerified() 
        && isValidPost(incoming())
        && incoming().userId == request.auth.uid
        && incoming().createdAt == request.time
        && incoming().likesCount == 0
        && incoming().commentsCount == 0;
        
      allow update: if isVerified() && isValidPost(incoming()) && (
        // Action: Like/Comment (increment)
        (incoming().diff(existing()).affectedKeys().hasOnly(['likesCount']) && (incoming().likesCount == existing().likesCount + 1 || incoming().likesCount == existing().likesCount - 1))
        || (incoming().diff(existing()).affectedKeys().hasOnly(['commentsCount']) && (incoming().commentsCount == existing().commentsCount + 1 || incoming().commentsCount == existing().commentsCount - 1))
        // Action: React
        || (incoming().diff(existing()).affectedKeys().hasOnly(['reactions']))
        // Action: Edit (Owner)
        || (isOwner(existing().userId) && incoming().diff(existing()).affectedKeys().hasOnly(['content', 'imageUrl', 'imageUrls', 'voiceUrl', 'type', 'editHistory', 'song']) && incoming().userId == existing().userId && incoming().createdAt == existing().createdAt)
      );
      allow delete: if isOwner(existing().userId);

      // --- Comments ---
      match /comments/{commentId} {
        function isValidComment(data) {
          let requiredKeys = ['userId', 'postId', 'content', 'createdAt', 'type'];
          let optionalKeys = ['imageUrl', 'voiceUrl', 'reactions', 'replyToId', 'replyToContent', 'replyToSenderName'];
          return data.userId is string
            && data.postId == postId
            && data.content is string
            && (data.type == 'text' || data.type == 'image' || data.type == 'voice')
            && data.keys().hasAll(requiredKeys)
            && data.keys().size() <= requiredKeys.size() + optionalKeys.size();
        }

        allow read: if isSignedIn();
        allow create: if isVerified() 
          && isValidComment(incoming())
          && incoming().userId == request.auth.uid
          && incoming().createdAt == request.time;
        allow update: if isVerified() && isValidComment(incoming()) && (
          incoming().diff(existing()).affectedKeys().hasOnly(['reactions'])
          && incoming().userId == existing().userId
          && incoming().createdAt == existing().createdAt
        );
        allow delete: if isOwner(existing().userId) || isOwner(get(/databases/$(database)/documents/posts/$(postId)).data.userId);
      }
    }

    // --- Notifications ---
    match /notifications/{notifId} {
      allow read: if isSignedIn() && resource.data.toUserId == request.auth.uid;
      allow create: if isVerified() && incoming().fromUserId == request.auth.uid;
      allow update: if isVerified() && resource.data.toUserId == request.auth.uid && incoming().diff(existing()).affectedKeys().hasOnly(['isRead']);
    }

    // --- Likes ---
    match /likes/{likeId} {
      allow read: if isSignedIn();
      allow create: if isVerified()
        && incoming().userId == request.auth.uid
        && incoming().createdAt == request.time;
      allow delete: if isSignedIn() && isOwner(existing().userId);
    }

    // --- Music History ---
    match /musicHistory/{historyId} {
      allow list: if isVerified() && resource.data.userId == request.auth.uid;
      allow create: if isVerified() 
        && incoming().userId == request.auth.uid
        && incoming().createdAt == request.time;
      allow delete: if isOwner(existing().userId);
    }

    // --- Subscriptions ---
    match /subscriptions/{subId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && incoming().userId == request.auth.uid && incoming().createdAt == request.time;
      allow delete: if isSignedIn() && existing().userId == request.auth.uid;
    }

    // --- Chats / Messages ---
    match /chats/{chatId} {
      function isMember() {
        return isSignedIn() && resource != null && request.auth.uid in resource.data.participants;
      }

      // Allow 'get' for non-existent docs to support existence checks for deterministic IDs
      allow get: if isSignedIn() && (resource == null || request.auth.uid in resource.data.participants);
      allow list: if isSignedIn() && isMember();
      
      allow create: if isVerified() && request.resource.data.participants.hasAll([request.auth.uid]);
      allow update: if isMember() && (
        incoming().diff(existing()).affectedKeys().hasOnly(['participants', 'name', 'photoURL', 'lastMessage', 'updatedAt', 'admins'])
      );
      allow delete: if isSignedIn() && (
        (resource.data.get('type', 'direct') == 'direct' && request.auth.uid in resource.data.participants) ||
        (resource.data.type == 'group' && (request.auth.uid in resource.data.get('admins', [])) && resource.data.participants.size() <= 1) ||
        (resource.data.type == 'group' && resource.data.participants.size() == 0)
      );

      match /messages/{messageId} {
        function isValidMessage(data) {
          let requiredKeys = ['senderId', 'content', 'createdAt', 'isRead', 'type'];
          let optionalKeys = ['receiverId', 'imageUrl', 'voiceUrl', 'reactions', 'replyToId', 'replyToContent', 'replyToSenderName', 'postId', 'readBy', 'deliveredTo', 'replyToType', 'chatId'];
          return data.senderId is string
            && data.content is string
            && (data.type == 'text' || data.type == 'image' || data.type == 'voice' || data.type == 'post' || data.type == 'system')
            && data.keys().hasAll(requiredKeys)
            && data.keys().size() <= requiredKeys.size() + optionalKeys.size();
        }

        allow read: if isChatParticipant(chatId);
        allow create: if isChatParticipant(chatId)
          && (
            (isVerified() && isValidMessage(incoming()) && incoming().senderId == request.auth.uid && incoming().createdAt == request.time)
            || (incoming().senderId == 'system' && incoming().type == 'system' && incoming().createdAt == request.time)
          );

        allow update: if isChatParticipant(chatId) && (
          (isOwner(existing().senderId) && isVerified() && isValidMessage(incoming()) && incoming().diff(existing()).affectedKeys().hasOnly(['content', 'imageUrl', 'voiceUrl', 'type', 'postId']))
          || (incoming().diff(existing()).affectedKeys().hasOnly(['isRead', 'readBy']))
          // Delivery acknowledgement: a recipient may only add themselves.
          || (incoming().diff(existing()).affectedKeys().hasOnly(['deliveredTo'])
              && request.auth.uid in incoming().deliveredTo
              && existing().senderId != request.auth.uid)
          || (incoming().diff(existing()).affectedKeys().hasOnly(['reactions']))
        );
        // Any participant can delete messages (needed for full chat deletion)
        allow delete: if isChatParticipant(chatId);
      }

      match /typing/{userId} {
        allow read: if isChatParticipant(chatId);
        // Any participant can delete typing indicators (needed for full chat deletion)
        allow delete: if isChatParticipant(chatId);
        allow write: if isOwner(userId) && isChatParticipant(chatId);
      }
    }

    match /{path=**}/messages/{messageId} {
      allow read: if isSignedIn() && (
        resource.data.receiverId == request.auth.uid || 
        resource.data.senderId == request.auth.uid ||
        (resource.data.chatId != null && request.auth.uid in get(/databases/$(database)/documents/chats/$(resource.data.chatId)).data.participants)
      );
    }
  }
}
